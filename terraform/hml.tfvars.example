# Ambiente HML (exemplo de comparação).
# Uso: terraform plan -var-file="hml.tfvars.example"
# ATENÇÃO: não aplique DEV e HML alternadamente sobre o mesmo state.
# Como o nome do bucket inclui o ambiente, trocar de dev para hml SUBSTITUI o bucket.

environment         = "hml"
default_ttl_seconds = 600
price_class         = "PriceClass_100"
enable_ipv6         = true
owner               = "time-hml"

extra_tags = {
  CostCenter = "laboratorio"
  Tier       = "homologacao"
}
