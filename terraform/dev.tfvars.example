# Ambiente DEV (exemplo de comparação).
# Uso: terraform plan -var-file="dev.tfvars.example"
# ATENÇÃO: não aplique DEV e HML alternadamente sobre o mesmo state.
# Veja docs/CONCEITOS.md (seção "Ambientes e state").

environment         = "dev"
default_ttl_seconds = 0
price_class         = "PriceClass_100"
enable_ipv6         = false
owner               = "time-dev"

extra_tags = {
  CostCenter = "laboratorio"
  Tier       = "desenvolvimento"
}
